{
	"name": "tarikicode-svelte",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"lint": "prettier --check . && eslint . && npm run lint:md",
		"lint:fix": "prettier --write . && eslint --fix . && npm run fix:md",
		"format": "prettier --write .",
		"lint:code": "prettier --check . && eslint .",
		"lint:code:fix": "prettier --write . && eslint --fix .",
		"prepare": "npm run smui-theme-light && npm run smui-theme-dark",
		"smui-theme-light": "smui-theme compile static/smui.css -i src/theme -i src/theme/excluded",
		"smui-theme-dark": "smui-theme compile static/smui-dark.css -i src/theme/dark -i src/theme/excluded",
		"lint:md": "markdownlint-cli2 **/*.md !node_modules !static",
		"fix:md": "markdownlint-cli2 --fix **/*.md !node_modules !static"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/cib": "^1.2.0",
		"@iconify-json/ic": "^1.2.0",
		"@iconify-json/logos": "^1.2.0",
		"@iconify-json/vscode-icons": "^1.2.42",
		"@material/theme": "^14.0.0",
		"@material/typography": "^14.0.0",
		"@smui/button": "^8.0.3",
		"@smui/card": "^8.0.3",
		"@smui/checkbox": "^8.0.3",
		"@smui/data-table": "^8.0.3",
		"@smui/dialog": "^8.0.3",
		"@smui/fab": "^8.0.3",
		"@smui/form-field": "^8.0.3",
		"@smui/icon-button": "^8.0.3",
		"@smui/layout-grid": "^8.0.3",
		"@smui/menu": "^8.0.3",
		"@smui/paper": "^8.0.3",
		"@smui/ripple": "^8.0.3",
		"@smui/tab": "^8.0.3",
		"@smui/tab-bar": "^8.0.3",
		"@smui/textfield": "^8.0.3",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.2.8",
		"@testing-library/user-event": "^14.6.1",
		"@types/leaflet": "^1.9.21",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"@vitest/ui": "^5.0.5",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"highlight.js": "^11.9.0",
		"markdownlint-cli2": "^0.24.0",
		"marked": "^12.0.1",
		"mermaid": "^12.2.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"smui-theme": "^8.0.3",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-eslint-parser": "^1.10.0",
		"swiper": "^12.1.2",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^7.3.7",
		"vitest": "^5.0.5"
	},
	"overrides": {
		"cookie": "^0.7.0",
		"minimatch": "^11.0.1"
	},
	"type": "module",
	"dependencies": {
		"chart.js": "^4.5.1",
		"chartjs-plugin-datalabels": "^2.2.0",
		"dompurify": "^3.4.17",
		"gray-matter": "^4.0.3",
		"happy-dom": "^21.0.4",
		"iconv-lite": "^0.7.0",
		"leaflet": "^1.9.4",
		"openai": "^6.1.0",
		"undici": "^6.24.0"
	}
}
